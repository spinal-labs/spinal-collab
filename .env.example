# Environment for deploying the relay. Docker Compose auto-loads .env from here;
# .env is gitignored so secrets never get committed.
#
#   cp .env.example .env   # set what your mode needs, then `docker compose -f <file> up -d --build`
#
# Two deploy modes:
#   • docker-compose.prod.yml    relay + Caddy (auto-HTTPS)        → needs COLLAB_DOMAIN
#   • docker-compose.shared.yml  relay behind an EXISTING proxy    → needs PROXY_NETWORK

# --- docker-compose.prod.yml (Caddy auto-HTTPS) ---
# Public domain for the relay (DNS A/AAAA → this host; ports 80 + 443 open).
COLLAB_DOMAIN=relay.yourdomain.com

# --- docker-compose.shared.yml (behind your existing nginx/Traefik) ---
# The proxy's docker network the relay joins so the proxy can reach it by name.
PROXY_NETWORK=monitoring_default

# --- optional, both modes ---
# Gate session minting (the host sends it as Authorization: Bearer when minting).
# Leave EMPTY for OPEN minting — anyone who can reach the relay can start a session.
# Generate one if you want it gated:  openssl rand -hex 32
COLLAB_CONTROL_TOKEN=
