# Environment for the production relay deploy (docker-compose.prod.yml).
#
#   cp .env.example .env        # then fill in the values below
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Docker Compose auto-loads .env from this directory; .env is gitignored so your
# token never gets committed. (These vars are unused by the local dev compose.yml.)

# Public domain for the relay. Its DNS A/AAAA record must point at this host, and
# inbound 80 + 443 must be open (Caddy needs 80 for the ACME challenge).
COLLAB_DOMAIN=relay.yourdomain.com

# Gate session minting — without it, anyone who can reach the relay can mint.
# Generate one with:  openssl rand -hex 32
# Hosts must pass the SAME value (COLLAB_CONTROL_TOKEN=...) when they `share`.
COLLAB_CONTROL_TOKEN=

# Optional: ACME contact email for cert-renewal notices. To use it, also uncomment
# the global block in infrastructure/caddy/Caddyfile.
#ACME_EMAIL=you@example.com
